# GrabMaps Platform API key (required). Server-side only — never exposed to the browser.
GRAB_MAPS_API_KEY=bm_xxx

# Optional: override the GrabMaps gateway base URL.
# GRAB_MAPS_BASE_URL=https://maps.grab.com/api/v1

# Optional: Upstash Redis for cloud-shared preferences (both phones in sync).
# Without these, preferences fall back to a non-durable in-memory store.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: simple passcode to gate access (just the two of you).
# APP_PASSCODE=
